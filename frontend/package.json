{
  "name": "newtonite-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Newtonite — Operations Under Pressure: React frontend for the operations API",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {

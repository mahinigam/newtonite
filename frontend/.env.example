# Frontend configuration. Copy to `frontend/.env` if you need to override.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# Where the API is. The backend allows this origin in `CORS_ALLOWED_ORIGINS`
# (default `http://localhost:5173`), and the dev server refuses to start on another
# port so a port clash cannot silently move the browser to a disallowed origin.
VITE_API_BASE_URL=http://localhost:8000
